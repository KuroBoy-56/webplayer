# Copia este archivo como local.properties (no se sube a GitHub) y completa los valores.
# sdk.dir lo escribe Android Studio solo.

# Obligatoria para activar equipos: llave maestra AES del panel (64 caracteres hex, la misma master_key_hex de includes/secrets.php).
# Es la única fuente de la llave: no está en el código ni en el repositorio, en ninguna forma.
# local.properties está en .gitignore, así que nunca se sube.
panel.master_key=

# Solo para publicar en Amazon Appstore: Amazon vuelve a firmar la app y, sin esto, se cierra al abrir en Fire TV.
# Copia el SHA-256 de Developer Console › tu app › APK › «Appstore Certificate Hashes» (con o sin los dos puntos).
amazon.cert_sha256=
