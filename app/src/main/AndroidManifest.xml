<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- descargas para ver sin internet: siguen con la app en segundo plano (notificación del progreso) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- avisos de partidos: a la hora exacta (si el usuario lo permite) y otra vez programados al reiniciar -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Solo celulares y tablets. Pide pantalla táctil, así Google Play no la ofrece en Android TV, Google TV ni TV Box
         (no tienen pantalla táctil); sin android.software.leanback ni LEANBACK_LAUNCHER tampoco entra en la tienda de los
         televisores. La app de TV es otra (com.latmpx.player.tv, ramas android-tv / play-store-tv). Sin orientación fija
         en el manifiesto: el teléfono se pone en vertical al abrir (MainActivity) y en tablets y pantallas grandes queda
         libre, como pide Google Play (sin avisos de pantallas grandes). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- Amazon Appstore: la verificación de licencia habla con la tienda (data/AmazonLicense.kt) -->
    <queries>
        <package android:name="com.amazon.sdktestclient" />
        <package android:name="com.amazon.venezia" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LatMpx"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.LatMpx.Player" />

        <service
            android:name=".data.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Amazon Appstore: respuesta de la verificación de licencia (data/AmazonLicense.kt) -->
        <receiver
            android:name="com.amazon.device.drm.ResponseReceiver"
            android:exported="true"
            android:permission="com.amazon.drm.Permission.NOTIFY">
            <intent-filter>
                <action android:name="com.amazon.drm.NOTIFY" />
            </intent-filter>
        </receiver>
        <receiver android:name=".data.MatchAlertReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
