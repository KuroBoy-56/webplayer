<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- descargas para ver sin internet: siguen con la app en segundo plano con JobScheduler (Android 14+: transferencia
         iniciada por el usuario, data/DownloadJob.kt); sin servicio en primer plano -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Solo celulares y tablets. Pide pantalla táctil, así Google Play no la ofrece en Android TV, Google TV ni TV Box
         (no tienen pantalla táctil); sin android.software.leanback ni LEANBACK_LAUNCHER tampoco entra en la tienda de los
         televisores. La app de TV es otra (com.latmpx.player.tv, ramas android-tv / play-store-tv). Sin orientación fija
         en el manifiesto: el teléfono se pone en vertical al abrir (MainActivity) y en tablets y pantallas grandes queda
         libre, como pide Google Play (sin avisos de pantallas grandes). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LatMpx"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.LatMpx.Player" />

        <service
            android:name=".data.DownloadJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
