<?xml version="1.0" encoding="utf-8"?>
<!-- los servidores IPTV casi siempre usan http o https con certificado propio -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
