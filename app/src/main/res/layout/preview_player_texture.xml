<?xml version="1.0" encoding="utf-8"?>
<!-- Miniatura de TV en vivo en Android 9 o anterior: TextureView en vez de SurfaceView (en esas versiones la superficie
     de video dentro de la pantalla de Compose podía cerrar la app al dibujar: NullPointerException mViewFlags) -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
