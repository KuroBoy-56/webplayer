{
  "name": "mpx-webos",
  "version": "1.0.0",
  "private": true,
  "description": "MPX Player para LG Smart TV (webOS): la app de Vega OS con react-native-web",
  "scripts": {
    "prepare:key": "node tools/prepare-key.js",
    "pretypecheck": "node tools/prepare-key.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node tools/build-webos.js",
    "package": "node tools/build-webos.js && ares-package -o out dist",
    "test": "node --test tools/*.test.js"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "react-native": "0.83.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
